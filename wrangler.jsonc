/**
 * CiteTrace — Cloudflare Workers Assets + Workers AI (/api/ask)
 * Production: https://citetrace.welchsoftware.net
 *
 * Subdomain only — do not claim welchsoftware.net / www (company site Worker).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "citetrace",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"ai": {
		"binding": "AI"
	},
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	/**
	 * DNS for welchsoftware.net must already be on this Cloudflare account.
	 * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	 */
	"routes": [
		{
			"pattern": "citetrace.welchsoftware.net",
			"custom_domain": true
		}
	],
	"upload_source_maps": true
}
